# Hardened DataBot image built on a WizOS near-zero-CVE base.
# WizOS images are pulled from the Wiz secured-image registry
# (registry.os.wiz.io) and require WizOS to be enabled on the tenant with
# pull credentials configured (directly or via a pull-through cache/mirror).
# Confirm the exact tag against the WizOS Secured Image Catalog before pinning.
ARG WIZOS_PYTHON_IMAGE=registry.os.wiz.io/wizos/python:3.13
FROM ${WIZOS_PYTHON_IMAGE}

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    AI_PROVIDER=vertex

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app.py agent.py db.py ./
COPY templates/ ./templates/
COPY static/ ./static/
COPY sql/ ./sql/
COPY data/ ./data/

EXPOSE 80

CMD ["gunicorn", "--bind", "0.0.0.0:80", "--workers", "2", "--timeout", "120", "app:app"]
